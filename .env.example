DATABASE_URL=postgresql://edgeboard:edgeboard@localhost:5432/edgeboard

# One key covers v1.basketball / v1.baseball / v1.hockey .api-sports.io
API_SPORTS_KEY=
# or via RapidAPI:
RAPIDAPI_KEY=
# Optional base URL overrides
# API_SPORTS_BASKETBALL_URL=https://v1.basketball.api-sports.io
# API_SPORTS_BASEBALL_URL=https://v1.baseball.api-sports.io
# API_SPORTS_HOCKEY_URL=https://v1.hockey.api-sports.io

# Only for rewording rationale bullets. Never for probabilities.
OPENAI_API_KEY=

SETTINGS_PIN=
SETTINGS_ENCRYPTION_KEY=
CRON_SECRET=
DEFAULT_TIMEZONE=Africa/Lagos
PREDICTION_LOCK_MINUTES=15

# Sportybet booking codes (experimental, unofficial endpoints)
SPORTYBET_ENABLED=true
SPORTYBET_REGION=ng
# Per-run limits that protect the API-Sports daily quota
MAX_ODDS_CALLS=30
